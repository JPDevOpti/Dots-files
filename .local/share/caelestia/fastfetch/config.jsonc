{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "color": {
            "1": "34",
            "2": "34",
            "3": "34",
            "4": "34",
            "5": "34",
            "6": "34",
            "7": "34",
            "8": "34",
            "9": "34"
        },
        "padding": {
            "top": 2,
            "right": 2
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "15",
            "separator": "15"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "╭──────────────────────────────╮",
            "paddingLeft": 16
        },
        {
            "type": "os",
            "key": "{#15}│{#} {#34}󰻀{#} distro ",
            "format": "{3>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "kernel",
            "key": "{#15}│{#} {#34}{#} kernel ",
            "format": "{2>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "command",
            "key": "{#15}│{#} {#34}{#} cpu    ",
            "text": "lscpu | grep 'Model name' | sed 's/.*: *//; s/AMD //; s/ w\\/.*//'",
            "format": "{1>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "command",
            "key": "{#15}│{#} {#34}󰢮{#} gpu    ",
            "text": "lspci | grep -i vga | grep -i nvidia | cut -d ':' -f 3 | sed 's/.*\\[//; s/\\].*//; s/NVIDIA //; s/GeForce //; s/ Mobile.*//; s/ Max-Q.*//'",
            "format": "{1>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "shell",
            "key": "{#15}│{#} {#34}{#} shell  ",
            "format": "{pretty-name>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "command",
            "key": "{#15}│{#} {#34}{#} mem    ",
            "text": "free -h | awk 'NR==2{printf \"%s / %s\", $3, $2}'",
            "format": "{1>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "command",
            "key": "{#15}│{#} {#34}{#} disk   ",
            "text": "df -h / | awk 'NR==2{printf \"%s / %s (%s)\", $3, $2, $5}'",
            "format": "{1>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "packages",
            "key": "{#15}│{#} {#34}{#} pkgs   ",
            "format": "{all>18} {#15}│{#}",
            "paddingLeft": 16
        },
        {
            "type": "custom",
            "format": "╰──────────────────────────────╯",
            "paddingLeft": 16
        },
        "break"
    ]
}
